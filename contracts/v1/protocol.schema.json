{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parchis-online.example/contracts/v1/protocol.schema.json",
  "title": "Parchís Online v1 client protocol",
  "oneOf": [
    { "$ref": "#/$defs/reconnect" },
    { "$ref": "#/$defs/playerReady" },
    { "$ref": "#/$defs/startGame" },
    { "$ref": "#/$defs/rollDice" },
    { "$ref": "#/$defs/movePiece" },
    { "$ref": "#/$defs/moveBonusPiece" },
    { "$ref": "#/$defs/returnToLobby" },
    { "$ref": "#/$defs/playAgain" },
    { "$ref": "#/$defs/chatMessage" },
    { "$ref": "#/$defs/reactionSent" },
    { "$ref": "#/$defs/giftSent" },
    { "$ref": "#/$defs/setCosmetics" }
  ],
  "$defs": {
    "roomCode": { "type": "string", "pattern": "^[A-Z2-9]{5}$" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "pieceId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "playerId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "base": {
      "type": "object",
      "required": ["type", "version", "requestId"],
      "properties": {
        "type": { "type": "string" },
        "version": { "const": 1 },
        "requestId": { "$ref": "#/$defs/requestId" }
      }
    },
    "reconnect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "roomCode", "playerToken"],
      "properties": {
        "type": { "const": "RECONNECT" },
        "version": { "const": 1 },
        "roomCode": { "$ref": "#/$defs/roomCode" },
        "playerToken": { "type": "string", "minLength": 32, "maxLength": 256 }
      }
    },
    "playerReady": {
      "$ref": "#/$defs/base",
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "PLAYER_READY" },
        "ready": { "type": "boolean" }
      },
      "required": ["type", "version", "requestId", "ready"]
    },
    "startGame": {
      "$ref": "#/$defs/base",
      "unevaluatedProperties": false,
      "properties": { "type": { "const": "START_GAME" } }
    },
    "rollDice": {
      "$ref": "#/$defs/base",
      "unevaluatedProperties": false,
      "properties": { "type": { "const": "ROLL_DICE" } }
    },
    "movePiece": {
      "$ref": "#/$defs/base",
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "MOVE_PIECE" },
        "pieceId": { "$ref": "#/$defs/pieceId" },
        "diceIndices": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 1 },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        }
      },
      "required": ["type", "version", "requestId", "pieceId", "diceIndices"]
    },
    "moveBonusPiece": {
      "$ref": "#/$defs/base",
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "MOVE_BONUS_PIECE" },
        "pieceId": { "$ref": "#/$defs/pieceId" }
      },
      "required": ["type", "version", "requestId", "pieceId"]
    },
    "returnToLobby": {
      "$ref": "#/$defs/base",
      "unevaluatedProperties": false,
      "properties": { "type": { "const": "RETURN_TO_LOBBY" } }
    },
    "playAgain": {
      "$ref": "#/$defs/base",
      "unevaluatedProperties": false,
      "properties": { "type": { "const": "PLAY_AGAIN" } }
    },
    "chatMessage": {
      "$ref": "#/$defs/base",
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "CHAT_MESSAGE" },
        "text": { "type": "string", "minLength": 1, "maxLength": 280 }
      },
      "required": ["type", "version", "requestId", "text"]
    },
    "reactionSent": {
      "$ref": "#/$defs/base",
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "REACTION_SENT" },
        "reactionId": {
          "enum": ["laugh", "cry", "angry", "cool", "shocked", "heart", "applause"]
        }
      },
      "required": ["type", "version", "requestId", "reactionId"]
    },
    "giftSent": {
      "$ref": "#/$defs/base",
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "GIFT_SENT" },
        "toPlayerId": { "$ref": "#/$defs/playerId" },
        "giftId": { "enum": ["rose", "tomato", "applause", "confetti", "heart", "fire"] }
      },
      "required": ["type", "version", "requestId", "toPlayerId", "giftId"]
    },
    "setCosmetics": {
      "$ref": "#/$defs/base",
      "unevaluatedProperties": false,
      "properties": {
        "type": { "const": "SET_COSMETICS" },
        "diceSkinId": { "enum": ["classic", "brass", "jade", "midnight"] },
        "pieceSkinId": { "enum": ["classic", "porcelain", "walnut", "glow"] }
      },
      "required": ["type", "version", "requestId", "diceSkinId", "pieceSkinId"]
    }
  }
}
